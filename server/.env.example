# Copy to .env and fill in. NEVER commit the real .env.
# Only the NEW / CHANGED keys are annotated; the rest are as before.

MONGO_URI=
JWT_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
PAYSTACK_SECRET_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
DEMO_EMAIL=
DEMO_CODE=
CLIENT_URL=
PORT=
GOOGLE_CLIENT_ID=

# NEW — Lara's Gmail. Without this, the "new order", "custom order" and
# "enquiry" emails to her are silently skipped (the server only logs a warning).
ADMIN_NOTIFY_EMAIL=

# NEW — the public address of THIS server (e.g. https://your-api.onrender.com).
# Used for the Unsubscribe link inside newsletter emails.
API_PUBLIC_URL=

# REMOVED — SKIP_BACKGROUND_REMOVAL is no longer used (background removal is gone).
